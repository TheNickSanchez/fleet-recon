# Fleet Recon frontend — local development configuration.
# Copy to .env.local and adjust. Never commit real secrets.

# Base path the browser calls. Keep the default relative path so requests are
# same-origin and pass through the Vite dev proxy — the session host sends no
# CORS headers (backend.md "No CORS middleware"). Set an absolute URL only if
# the API is ever put behind a CORS-enabled reverse proxy.
VITE_API_BASE_URL=/api/v1

# Where the dev server forwards /api requests. The session host binds to
# 127.0.0.1:8100 by default (SESSION_HOST_HOST / SESSION_HOST_PORT in the
# repository root's .env.example) — there is no workspace path segment.
VITE_API_PROXY_TARGET=http://127.0.0.1:8100

# Dev/preview server port.
VITE_PORT=5173

# ---------------------------------------------------------------------------
# There is no dev-identity block here on purpose. The session host is a
# private bind with no per-actor auth at all (backend.md "Known Gaps") — not
# even the dev-header stand-in the previous, superseded pass simulated
# against a different backend. Access control is "run this only where it
# should be reachable," not a claim this client can present.
# ---------------------------------------------------------------------------
