# Fleet Recon session-host MVP environment template.
# Copy to `.env` (git-ignored). Never commit secret values.
# Product runtime: Claude Agent SDK via LiteLLM (not a raw Anthropic key).

# --- Runtime selection ---
AAMAD_TARGET_RUNTIME=claude-agent-sdk

# --- LiteLLM (Anthropic-compatible proxy) ---
# ANTHROPIC_API_KEY is the LiteLLM key, not a first-party Anthropic key.
ANTHROPIC_API_KEY=
# LiteLLM proxy Anthropic-compatible base path (operator supplies the real URL).
ANTHROPIC_BASE_URL=https://litellm.example.invalid
# Model id as LiteLLM exposes it (not a raw Anthropic model string unless that is what LiteLLM lists).
LITELLM_MODEL=

# --- Session host process (entrypoint implemented by @backend.eng) ---
SESSION_HOST_HOST=127.0.0.1
SESSION_HOST_PORT=8100

# Host working directory for asset-ops scripts (do not copy the skill tree).
ASSET_OPS_SCRIPTS_DIR=docs/.claude/skills/asset-ops/scripts
# Session-scoped temp and reports (no object store).
SESSION_TMP_DIR=session-host/var/tmp
SESSION_REPORTS_DIR=session-host/var/reports

# --- MCP transport (local stdio now; HTTP is Future Work, not implemented) ---
# Name-list / CSV path (asset-ops steps 1–4) must not require MCP.
# MCP is for device-lookup and optional asset-ops step 1.5 only.
MCP_TRANSPORT=stdio
MCP_SERVERS_CONFIG=session-host/config/mcp.stdio.json

# Future Work shape only (do not implement an HTTP MCP client in this project):
# MCP_TRANSPORT=http
# MCP_JAMF_URL=https://mcp.example.invalid/jamf
# MCP_INTUNE_URL=https://mcp.example.invalid/intune
# MCP_SERVICENOW_URL=https://mcp.example.invalid/servicenow

# --- Passkey profiles for asset-ops steps 1–2 (profile names, then env names they inject) ---
# Profile `servicenow` (step 1: asset_report_build.py)
SNOW_HOST=
SNOW_USERNAME=
SNOW_PASSWORD=
# Profile `jamf_api` (step 2: asset_report_mdm.py, macOS rows)
JAMF_BASE_URL=
JAMF_CLIENT_ID=
JAMF_CLIENT_SECRET=
# Profile `intune` (step 2: asset_report_mdm.py, Windows rows)
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
