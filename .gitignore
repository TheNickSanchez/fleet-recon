# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment and secrets
.env
.env.*
!.env.example

# Test, coverage, lint, and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# CrewAI leftover local state (unused FastAPI/CrewAI tree)
.crewai/
project-context/2.build/logs/

# Session-host runtime files (session-scoped; no object store)
session-host/var/tmp/*
session-host/var/reports/*
!session-host/var/tmp/.gitkeep
!session-host/var/reports/.gitkeep
session-host/config/mcp.stdio.json
session-host/config/mcp.http.json

# Editor and operating system files
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json